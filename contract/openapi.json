{
  "openapi": "3.0.0",
  "info": {
    "title": "anonymize API",
    "version": "0.1.0",
    "description": "Privacy-first PII redaction API. v1 contract."
  },
  "servers": [
    {
      "url": "https://anonymize.example",
      "description": "production (placeholder)"
    },
    {
      "url": "http://localhost:3001",
      "description": "local dev"
    }
  ],
  "paths": {
    "/api/v1/anonymize": {
      "post": {
        "description": "Anonymize text: detect PII spans and return the rendered `anonymized` field plus the structured spans for client-side customization. The optional `markerFormat` selects the render format; tier gating applies (Free: xxxxx/blackbar; paid tiers Docs/API/Pro/Ultra: also `default`; Pro/Ultra additionally: `custom`). Omit `markerFormat` to fall back to the caller's user-profile preference, then to the tier default. The optional `ambiguous` field controls how low-confidence detections (the UNKLAR/ambiguous layer) render in `anonymized`: `redact` (default) splices them in as `[UNKLAR_n]` — masked formats (xxxxx/blackbar) mask them exactly like any other span; `mark` inlines the original text alongside the marker as `[UNKLAR_n: original]`; `keep` leaves them as plaintext, the legacy behavior. `redact` is the default because uncertain detections used to reach every caller as plaintext regardless of tier — a leak this field closes; older or generic callers that omit it get the safe default automatically. `uncertainSpans` (offsets, category, score) is returned in ALL three modes, unaffected by this field. Its `id` is a per-category preview counter independent of the `[UNKLAR_n]` numbering in `anonymized` (that one runs under a single shared `UNKLAR` label) — correlate an `uncertainSpans[]` entry to its marker in the text (or vice versa) by `start`/`end`, which is exact and present in both regardless of mode.",
        "summary": "Anonymize text",
        "tags": ["anonymize"],
        "security": [
          {
            "ApiKey": []
          },
          {
            "Session": []
          },
          {}
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnonymizeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Anonymized result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnonymizeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Two distinct cases: (1) `code: 'turnstile_required'` — an anonymous request needs a Cloudflare Turnstile token (or a valid IP-bound verified cookie); signed-in and API-key callers never see this one; carries `message`. (2) `code: 'invalid_api_key'` — the Authorization header named a key that is malformed, unknown, or revoked; no `reason` (an attacker should not learn whether a key ever existed) and no `message`. Distinct from `account_tier_required` below: this is about the key itself, not the plan behind it.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": ["turnstile_required"]
                            },
                            {
                              "type": "string",
                              "enum": ["invalid_api_key"]
                            }
                          ]
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": ["code"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "402": {
            "description": "Tier required. Two distinct cases: (1) `code: 'tier_required'` — the requested `markerFormat` is not available on the caller's tier (body adds `markerFormat`, `tier`); (2) `code: 'account_tier_required'` — the API key is valid, but the account it belongs to has no API access on the Free plan (body adds `tier: 'free'`, `channel: 'api'`). The key itself is not revoked - upgrading the account to Docs or above reactivates it."
          },
          "413": {
            "description": "Text exceeds the caller's tier char limit"
          },
          "422": {
            "description": "`code: 'custom_rules_timeout'` — one or more of the caller's active custom rules exceeded the anonymize-time processing budget against this request's text (defense in depth: a pattern that passed save-time validation but still backtracks catastrophically at runtime). Fails closed — the request is rejected rather than silently completing with custom rules skipped. Review and adjust the offending custom rule(s); the response never names the pattern or request text."
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/api/v1/anonymize-file": {
      "post": {
        "description": "Anonymize a Word document (.docx, max 10 MB) or a PDF (.pdf, max 20 MB and 500 pages). The output is always rebuilt from scratch with all detected PII replaced by markers — only deliberately extracted content reaches it, so hidden data (comments, tracked changes, metadata, embedded objects) is removed by construction, and no original content stream survives underneath a redaction.\n\n**PDF input** is read through its text layer and returned as paragraphs and page breaks. Layout, tables, columns, headers/footers and images are NOT preserved — tables and columns come back as ordinary paragraphs in reading order, and every PDF response carries a `pdf_layout_flattened` warning saying so. A scanned PDF with no text layer is rejected (`no_text_layer`); there is no OCR.\n\nMultipart upload with a `file` part, an optional `markerFormat` field (same tier gating as /anonymize), an optional `redactUncertain` field, and an optional `outputFormat` field. Send every field BEFORE the file part — fields after the file are not reliably parsed. Requires a paid plan (Docs and up); anonymous callers are rejected. Degradations (omitted footnotes, merged cells, flattened PDF layout, ...) are reported honestly in `warnings`.\n\n`redactUncertain` is `\"true\"` | `\"false\"` (strict — any other value 400s), default `\"false\"`: when `\"true\"`, low-confidence detections are ALSO replaced in the output; either way they are always listed in `uncertainSpans` for review.\n\n`outputFormat` is `\"docx\"` | `\"text\"` (strict) and applies to PDF input only. It defaults to `\"text\"` on the API-key channel and `\"docx\"` on the browser channel. With `\"text\"` the response carries the anonymized string instead of a file, pages separated by a form feed (`\\f`, the pdftotext convention). A .docx upload has real structure to preserve and therefore has no text mode: asking for one returns 400 `unsupported_output_format`.",
        "summary": "Anonymize a .docx or .pdf file",
        "tags": ["anonymize"],
        "security": [
          {
            "ApiKey": []
          },
          {
            "Session": []
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "markerFormat": {
                    "type": "string",
                    "enum": ["default", "xxxxx", "blackbar", "custom"]
                  },
                  "redactUncertain": {
                    "type": "string",
                    "enum": ["true", "false"],
                    "description": "Also replace low-confidence detections in the output. Default \"false\" when omitted."
                  },
                  "outputFormat": {
                    "type": "string",
                    "enum": ["docx", "text"],
                    "description": "PDF input only. Default \"text\" for API-key callers, \"docx\" for session callers. Rejected with 400 for .docx input."
                  }
                },
                "required": ["file"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Redacted document + span report, or — for PDF input with `outputFormat=text` — the anonymized text + span report. Which shape arrives is decided by `outputFormat`, so a client that never sends it always gets the one its channel defaults to.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AnonymizeFileResponse"
                    },
                    {
                      "$ref": "#/components/schemas/AnonymizeFileTextResponse"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Not a valid .docx or .pdf (`invalid_file`; PDF parse failures carry `reason: \"INVALID_PDF\"`), missing file part, `redactUncertain`/`outputFormat` sent as an unsupported value (`invalid_field`), or `outputFormat=text` requested for .docx input (`unsupported_output_format`)"
          },
          "401": {
            "description": "Two distinct cases: (1) no Authorization header and no session cookie at all — files require an account, there is no anonymous upload; body is `{ error: { message: 'unauthenticated' } }`. (2) `code: 'invalid_api_key'` — the Authorization header named a key that is malformed, unknown, or revoked; body is `{ error: { code: 'invalid_api_key' } }`. No `reason` in either body.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "error": {
                          "type": "object",
                          "properties": {
                            "message": {
                              "type": "string",
                              "enum": ["unauthenticated"]
                            }
                          },
                          "required": ["message"]
                        }
                      },
                      "required": ["error"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "error": {
                          "type": "object",
                          "properties": {
                            "code": {
                              "type": "string",
                              "enum": ["invalid_api_key"]
                            }
                          },
                          "required": ["code"]
                        }
                      },
                      "required": ["error"]
                    }
                  ]
                }
              }
            }
          },
          "402": {
            "description": "Tier required: Free-tier callers (`required: 'docs'`), or the requested `markerFormat` is not available on the caller's tier"
          },
          "413": {
            "description": "File exceeds the cap for its format (`file_too_large`, with the applicable `limit`), the PDF has more pages than allowed (`too_many_pages`, with `limit` and `actual`), or the extracted text exceeds the tier char limit (`char_limit_exceeded`)"
          },
          "422": {
            "description": "Password-protected/encrypted document (`encrypted_file`), or a PDF with no text layer — a scan (`no_text_layer`). Neither is retryable, and there is no OCR path."
          },
          "429": {
            "description": "Rate limit exceeded (shared daily budget with /anonymize)"
          },
          "503": {
            "description": "Processing at capacity or inference unavailable — retry later"
          }
        }
      }
    },
    "/api/v1/limits": {
      "get": {
        "description": "Current effective rate limits (reads from env vars, so self-hosted instances return their own configured values).",
        "summary": "Get rate limits",
        "tags": ["system"],
        "responses": {
          "200": {
            "description": "Rate limits",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LimitsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnonymizeRequest": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500000
          },
          "markerFormat": {
            "type": "string",
            "enum": ["default", "custom", "xxxxx", "blackbar"]
          },
          "turnstile_token": {
            "type": "string"
          },
          "ambiguous": {
            "type": "string",
            "enum": ["redact", "keep", "mark"],
            "default": "redact"
          },
          "customMarkerMap": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": ["text"]
      },
      "AnonymizeResponse": {
        "type": "object",
        "properties": {
          "anonymized": {
            "type": "string"
          },
          "spans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                },
                "category": {
                  "type": "string"
                },
                "id": {
                  "type": "integer",
                  "minimum": 0,
                  "exclusiveMinimum": true
                },
                "original": {
                  "type": "string"
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": ["start", "end", "category", "id", "original"]
            }
          },
          "uncertainSpans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                },
                "category": {
                  "type": "string"
                },
                "id": {
                  "type": "integer",
                  "minimum": 0,
                  "exclusiveMinimum": true
                },
                "original": {
                  "type": "string"
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": ["start", "end", "category", "id", "original"]
            }
          },
          "stats": {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string"
              },
              "processed_chars": {
                "type": "integer",
                "minimum": 0
              },
              "servedBy": {
                "type": "string",
                "enum": ["slow", "fast", "gpu"]
              }
            },
            "required": ["request_id", "processed_chars", "servedBy"]
          }
        },
        "required": ["anonymized", "spans", "uncertainSpans", "stats"]
      },
      "AnonymizeFileResponse": {
        "type": "object",
        "properties": {
          "file": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "mimeType": {
                "type": "string"
              },
              "contentBase64": {
                "type": "string"
              }
            },
            "required": ["name", "mimeType", "contentBase64"]
          },
          "spans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                },
                "category": {
                  "type": "string"
                },
                "id": {
                  "type": "integer",
                  "minimum": 0,
                  "exclusiveMinimum": true
                },
                "original": {
                  "type": "string"
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": ["start", "end", "category", "id", "original"]
            }
          },
          "uncertainSpans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                },
                "category": {
                  "type": "string"
                },
                "id": {
                  "type": "integer",
                  "minimum": 0,
                  "exclusiveMinimum": true
                },
                "original": {
                  "type": "string"
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": ["start", "end", "category", "id", "original"]
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": ["code", "detail"]
            }
          },
          "stats": {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string"
              },
              "extractedChars": {
                "type": "number"
              },
              "servedBy": {
                "type": "string"
              }
            },
            "required": ["request_id", "extractedChars", "servedBy"]
          }
        },
        "required": ["file", "spans", "uncertainSpans", "warnings", "stats"]
      },
      "AnonymizeFileTextResponse": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "spans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                },
                "category": {
                  "type": "string"
                },
                "id": {
                  "type": "integer",
                  "minimum": 0,
                  "exclusiveMinimum": true
                },
                "original": {
                  "type": "string"
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": ["start", "end", "category", "id", "original"]
            }
          },
          "uncertainSpans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                },
                "category": {
                  "type": "string"
                },
                "id": {
                  "type": "integer",
                  "minimum": 0,
                  "exclusiveMinimum": true
                },
                "original": {
                  "type": "string"
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": ["start", "end", "category", "id", "original"]
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": ["code", "detail"]
            }
          },
          "stats": {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string"
              },
              "extractedChars": {
                "type": "number"
              },
              "servedBy": {
                "type": "string"
              }
            },
            "required": ["request_id", "extractedChars", "servedBy"]
          }
        },
        "required": ["text", "spans", "uncertainSpans", "warnings", "stats"]
      },
      "LimitsResponse": {
        "type": "object",
        "properties": {
          "current": {
            "type": "object",
            "properties": {
              "tier": {
                "type": "string",
                "enum": ["anon", "free", "docs", "api", "pro", "ultra"]
              },
              "channel": {
                "type": "string",
                "enum": ["web", "api"]
              },
              "daily_limit": {
                "type": "integer"
              },
              "entitled": {
                "type": "boolean"
              }
            },
            "required": ["tier", "channel", "daily_limit", "entitled"]
          },
          "reference": {
            "type": "object",
            "properties": {
              "web": {
                "type": "object",
                "properties": {
                  "anon": {
                    "type": "integer"
                  },
                  "free": {
                    "type": "integer"
                  },
                  "docs": {
                    "type": "integer"
                  },
                  "api": {
                    "type": "integer"
                  },
                  "pro": {
                    "type": "integer"
                  },
                  "ultra": {
                    "type": "integer"
                  }
                },
                "required": ["anon", "free", "docs", "api", "pro", "ultra"]
              },
              "api": {
                "type": "object",
                "properties": {
                  "free": {
                    "type": "integer"
                  },
                  "docs": {
                    "type": "integer"
                  },
                  "api": {
                    "type": "integer"
                  },
                  "pro": {
                    "type": "integer"
                  },
                  "ultra": {
                    "type": "integer"
                  }
                },
                "required": ["free", "docs", "api", "pro", "ultra"]
              }
            },
            "required": ["web", "api"]
          },
          "burst": {
            "type": "object",
            "properties": {
              "magic_link_per_hour": {
                "type": "integer"
              }
            },
            "required": ["magic_link_per_hour"]
          },
          "anonymize": {
            "type": "object",
            "properties": {
              "anonymous_per_day": {
                "type": "integer"
              },
              "user_per_day": {
                "type": "integer"
              },
              "apikey_per_day": {
                "type": "integer"
              }
            },
            "required": ["anonymous_per_day", "user_per_day", "apikey_per_day"]
          },
          "auth": {
            "type": "object",
            "properties": {
              "magic_link_per_hour": {
                "type": "integer"
              }
            },
            "required": ["magic_link_per_hour"]
          }
        },
        "required": ["current", "reference", "burst", "anonymize", "auth"]
      }
    }
  }
}
